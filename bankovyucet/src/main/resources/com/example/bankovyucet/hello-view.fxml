<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bankovyucet.HelloController" prefWidth="750" prefHeight="495" style="-fx-background-color: #f4f5f7;">
    <top>
        <VBox spacing="14" style="-fx-padding: 16;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Starting balance:"/>
                <TextField fx:id="startingBalanceField" prefWidth="120"/>
                <Button text="Create Account" onAction="#createAccount"/>
                <Label text="Balance:" style="-fx-padding: 0 0 0 15;"/>
                <Label fx:id="balanceLabel" text="0,00 €" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Type:"/>
                <ComboBox fx:id="typeBox" prefWidth="125"/>
                <Label text="Sum:"/>
                <TextField fx:id="amountField" prefWidth="110"/>
                <Button fx:id="runOneButton" text="Run client" onAction="#runOne"/>
                <Button fx:id="runFiveButton" text="Run 5 clients" onAction="#runFive"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8" style="-fx-padding: 0 16 16 16;">
            <Label text="Transactions:"/>
            <TextArea fx:id="transactionsArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
