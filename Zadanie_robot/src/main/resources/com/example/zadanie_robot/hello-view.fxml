<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.zadanie_robot.HelloController" prefWidth="800" prefHeight="550" spacing="10">
    <HBox alignment="CENTER"
          spacing="20"
          style="-fx-padding: 10;">
        <Button fx:id="btnAuto" text="Automatický režim" onAction="#changeMode"/>
        <Label text="Ovládanie: W S A D"/>
    </HBox>
    <Pane fx:id="plocha" prefWidth="800" prefHeight="480" VBox.vgrow="ALWAYS" style="-fx-background-color: #eeeeee;"/>
</VBox>