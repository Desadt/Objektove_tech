<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.zadanie_1.HelloController"
      prefWidth="850"
      prefHeight="550"
      spacing="10">

   <HBox spacing="10" alignment="CENTER"
         style="-fx-padding: 10;">

      <Button text="Obdĺžnik"
              onAction="#addRectangle"/>

      <Button text="Kruh"
              onAction="#addCircle"/>

      <Button text="Štvorec"
              onAction="#addSquare"/>

      <Button text="Modré kruhy"
              onAction="#changeColors"/>

      <Button text="Posunúť nadol"
              onAction="#moveDown"/>

   </HBox>

   <AnchorPane fx:id="plocha"
               prefWidth="850"
               prefHeight="480"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: #eeeeee;"/>

</VBox>