<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.zadanie_weather.HelloController" prefWidth="850" prefHeight="550" spacing="10">
    <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10;">
        <Button text="Pridať oblak" onAction="#addCloud"/>
        <Button text="Pridať dážď" onAction="#addRaindrop"/>
        <Button text="Pridať sneh" onAction="#addSnowflake"/>
        <Button fx:id="btnRain" text="Zastaviť dážď" onAction="#stopRain"/>
        <Button text="Modré oblaky" onAction="#changeClouds"/>
        <Button text="Posunúť doľava" onAction="#moveLeft"/>
    </HBox>
    <Pane fx:id="plocha" prefWidth="850" prefHeight="480" VBox.vgrow="ALWAYS" style="-fx-background-color: #eef6ff;"/>
</VBox>