<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.nakupnyzoznam.HelloController" spacing="12" prefWidth="650" prefHeight="460" style="-fx-background-color: #f6f8fb;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>
    <Label text="Nákupný zoznam" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #253247;" />
    <Label text="Pridaj položku alebo označ existujúcu a uprav ju." style="-fx-text-fill: #68758a;" />
    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Názov položky" />
            <TextField fx:id="nazovField" promptText="napr. Mlieko" prefWidth="400" onAction="#pridaj" />
        </VBox>
        <VBox spacing="5">
            <Label text="Počet kusov" />
            <TextField fx:id="pocetField" promptText="napr. 2" prefWidth="130" onAction="#pridaj" />
        </VBox>
    </HBox>
    <HBox spacing="10">
        <Button text="Pridať" onAction="#pridaj" style="-fx-background-color: #2563eb; -fx-text-fill: white;" />
        <Button text="Upraviť označenú" onAction="#uprav" />
        <Button text="Odstrániť označenú" onAction="#odstran" />
    </HBox>
    <ListView fx:id="list" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px;" />
    <Label fx:id="pocetLabel" text="Celkový počet položiek: 0" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #253247;" />
</VBox>
